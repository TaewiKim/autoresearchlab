# ResearchLab settings. Copy to researchlab.env and edit:
#
#   cp researchlab.env.example researchlab.env
#
# researchlab.env is git-ignored and holds settings only: keys go through
# `researchlab keys` (below). scripts/run-cycle.sh reads it before a cycle.

# --- Python ----------------------------------------------------------------
# The interpreter the analysis and literature drivers run on. `researchlab
# bootstrap` creates .venv; the Docker image sets this already.
export RESEARCHLAB_PYTHON="$PWD/.venv/bin/python"
# A simulator interpreter, when you run robotics cycles (MuJoCo installed).
# export RESEARCHLAB_MUJOCO_PYTHON="$PWD/.venv/bin/python"

# --- Agent runtime -----------------------------------------------------------
export RESEARCHLAB_AGENT_RUNTIME=codex
# Codex runs each lane in its sandbox, writing only inside the workspace.
# Without these two the harness runs Codex with no sandbox at all.
export RESEARCHLAB_CODEX_SANDBOX=workspace-write
export RESEARCHLAB_CODEX_APPROVAL_POLICY=on-request

# --- Literature network ------------------------------------------------------
# Scholarly lookups go only to approved metadata APIs, GET only.
export RESEARCHLAB_LITERATURE_NETWORK_POLICY=approved-scholarly-metadata-v1
# The hosts a scout lane's sandbox may reach.
export RESEARCHLAB_CODEX_NETWORK_DOMAINS="api.openalex.org,api.semanticscholar.org,api.crossref.org,export.arxiv.org,arxiv.org,api.opencitations.net,ar5iv.labs.arxiv.org,api.github.com,huggingface.co"
# Engineer lanes may install open-source libraries and models (pypi, GitHub,
# Hugging Face, ...). Set to 0 to keep every lane on the scholarly hosts.
export RESEARCHLAB_OPEN_SOURCE_ASSETS=1

# --- API keys -----------------------------------------------------------------
# Not here. Enter your own keys with the CLI; they are kept in
# ~/.researchlab/.env (mode 0600), outside this repository:
#   researchlab setup                  # every key, one question each
#   researchlab keys set openalex      # one key; typing is hidden
#   researchlab keys list              # what is set (masked)

# --- Cycle budget --------------------------------------------------------------
# Follow-up lanes one cycle may create in total (default 4096).
# export RESEARCHLAB_FOLLOWUP_BUDGET=4096

# --- Maintainer (advanced, off by default) -------------------------------------
# When the harness itself misbehaves during a cycle, a Codex maintainer diagnoses
# it and commits a fix to your local clone. It never pushes unless asked.
# export RESEARCHLAB_MAINTAINER=1
# export RESEARCHLAB_MAINTAINER_PUSH=0

# Node heap for long cycles.
export NODE_OPTIONS="--max-old-space-size=4096"
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
